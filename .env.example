# Never commit real secrets. Copy to .env locally.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Du bist CyberSarah und antwortest hilfreich, präzise und sicher.
DATABASE_PATH=data/cybersarah.sqlite
DEV_USER_ID=local-user
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_CLIENT_ID=external-client
JWT_CLIENT_SECRET=replace-with-a-long-client-secret
JWT_ISSUER=cybersarah-21
JWT_AUDIENCE=cybersarah-api
JWT_TTL_SECONDS=3600
PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=5
CORS_ORIGINS=
TRUST_PROXY=false
FORCE_HTTPS=false
